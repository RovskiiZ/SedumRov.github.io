
---
const projects = [
  {
    number: "01",
    title: "技术美术探索",
    description: "探索程序、美术与实时渲染之间的联系。",
    tags: ["TA", "Shader", "实时渲染"],
  },
  {
    number: "02",
    title: "Blender 三维场景",
    description: "尝试程序化建模、材质制作与风格化场景。",
    tags: ["Blender", "3D", "程序化"],
  },
  {
    number: "03",
    title: "编程与图形学",
    description: "记录 C++ 学习、算法练习与计算机图形学知识。",
    tags: ["C++", "算法", "图形学"],
  },
];

const interests = ["计算机图形学", "游戏引擎", "技术美术", "Blender", "前端开发"];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0d12" />
    <meta
      name="description"
      content="个人博客，记录编程、计算机图形学、Blender 与技术美术的学习和实践。"
    />
    <title>我的数字空间 · 个人博客</title>
    <style>
      :root {
        color-scheme: dark;
        --bg: #0b0d12;
        --panel: #121620;
        --text: #edf0f7;
        --muted: #929bad;
        --line: #272d3a;
        --accent: #8b9cff;
        --mint: #75e0c1;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background:
          radial-gradient(ellipse at 80% 0%, #202847 0, transparent 36%),
          var(--bg);
        color: var(--text);
        font-family: Inter, "Segoe UI", "Microsoft YaHei", sans-serif;
        line-height: 1.7;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      a:focus-visible {
        outline: 2px solid var(--mint);
        outline-offset: 5px;
      }

      .container {
        width: min(1080px, calc(100% - 40px));
        margin: 0 auto;
      }

      header {
        border-bottom: 1px solid #ffffff12;
      }

      .nav {
        min-height: 76px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .brand {
        font-weight: 750;
        letter-spacing: -0.5px;
      }

      .brand span {
        color: var(--mint);
      }

      .nav-links {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        color: var(--muted);
        font-size: 14px;
      }

      .nav-links a:hover {
        color: var(--text);
      }

      .hero {
        padding: 104px 0 88px;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 6px 12px;
        border: 1px solid #75e0c133;
        border-radius: 999px;
        color: var(--mint);
        font-size: 13px;
      }

      .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--mint);
        box-shadow: 0 0 12px #75e0c188;
      }

      h1 {
        max-width: 800px;
        margin: 28px 0 18px;
        font-size: clamp(42px, 7vw, 76px);
        line-height: 1.13;
        letter-spacing: -2.8px;
      }

      h1 .gradient {
        color: var(--accent);
        background: linear-gradient(100deg, #a8b5ff, #75e0c1);
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .hero-description {
        max-width: 620px;
        margin: 0;
        color: var(--muted);
        font-size: 17px;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 30px;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0 18px;
        border: 1px solid var(--line);
        border-radius: 10px;
        font-size: 14px;
        font-weight: 650;
        transition: transform 160ms ease, border-color 160ms ease;
      }

      .button:hover {
        transform: translateY(-2px);
        border-color: var(--accent);
      }

      .button-primary {
        color: #0b0d12;
        background: var(--mint);
        border-color: var(--mint);
      }

      section {
        padding: 42px 0 72px;
      }

      .section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
      }

      .section-kicker {
        color: var(--mint);
        font-size: 12px;
        font-weight: 750;
        letter-spacing: 2px;
        text-transform: uppercase;
      }

      h2 {
        margin: 6px 0 0;
        font-size: 29px;
        letter-spacing: -0.8px;
      }

      .section-note {
        color: var(--muted);
        font-size: 13px;
      }

      .project-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
      }

      .project-card {
        min-height: 230px;
        padding: 24px;
        border: 1px solid var(--line);
        border-radius: 16px;
        background: linear-gradient(145deg, #171c28, #10131b);
        transition: transform 180ms ease, border-color 180ms ease;
      }

      .project-card:hover {
        transform: translateY(-4px);
        border-color: #8b9cfa77;
      }

      .project-number {
        color: var(--mint);
        font-size: 12px;
        font-weight: 750;
        letter-spacing: 1px;
      }

      .project-card h3 {
        margin: 22px 0 8px;
        font-size: 19px;
      }

      .project-card p {
        min-height: 52px;
        margin: 0;
        color: var(--muted);
        font-size: 14px;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 20px;
      }

      .tag {
        padding: 4px 8px;
        border-radius: 6px;
        background: #ffffff09;
        color: #c4cada;
        font-size: 11px;
      }

      .about-panel {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 32px;
        padding: 32px;
        border: 1px solid var(--line);
        border-radius: 18px;
        background: #121620bb;
      }

      .about-panel h3 {
        margin-top: 0;
        font-size: 21px;
      }

      .about-panel p {
        margin-bottom: 0;
        color: var(--muted);
        font-size: 14px;
      }

      .interest-list {
        display: flex;
        align-content: start;
        flex-wrap: wrap;
        gap: 9px;
      }

      .interest {
        padding: 8px 12px;
        border: 1px solid #343c4d;
        border-radius: 9px;
        color: #d8def0;
        font-size: 13px;
      }

      .contact {
        padding: 34px;
        border: 1px solid #8b9cff35;
        border-radius: 18px;
        background: linear-gradient(110deg, #171c2a, #111720);
      }

      .contact p {
        color: var(--muted);
      }

      footer {
        padding: 26px 0 34px;
        border-top: 1px solid #ffffff12;
        color: var(--muted);
        font-size: 12px;
      }

      .footer-inner {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
      }

      @media (max-width: 760px) {
        .hero {
          padding: 76px 0 60px;
        }

        h1 {
          letter-spacing: -1.7px;
        }

        .project-grid {
          grid-template-columns: 1fr;
        }

        .project-card {
          min-height: auto;
        }

        .about-panel {
          grid-template-columns: 1fr;
          padding: 24px;
        }

        .section-heading {
          align-items: start;
          flex-direction: column;
          gap: 6px;
        }
      }

      @media (max-width: 460px) {
        .container {
          width: min(100% - 28px, 1080px);
        }

        .nav {
          align-items: start;
          flex-direction: column;
          justify-content: center;
          padding: 18px 0;
          gap: 12px;
        }

        .nav-links {
          gap: 16px;
        }

        .contact {
          padding: 24px;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <div class="container nav">
        <a class="brand" href="#top">MY<span>.</span>SPACE</a>
        <nav class="nav-links" aria-label="主导航">
          <a href="#projects">项目</a>
          <a href="#about">关于我</a>
          <a href="#contact">联系</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <div class="container">
        <section class="hero">
          <div class="eyebrow">
            <span class="status-dot"></span>
            个人博客 · 持续探索中
          </div>

          <h1>
            用代码构建想象，<br />
            用技术创造<span class="gradient">可能。</span>
          </h1>

          <p class="hero-description">
            你好，我是SedumRov。欢迎来到我的数字空间。这里记录我在编程、计算机图形学、
            三维创作与技术美术方向上的学习过程、实验和想法。
          </p>

          <div class="hero-actions">
            <a class="button button-primary" href="#projects">探索我的项目 ↗</a>
            <a class="button" href="#about">认识一下我</a>
          </div>
        </section>

        <section id="projects">
          <div class="section-heading">
            <div>
              <div class="section-kicker">Selected Works</div>
              <h2>正在探索的方向</h2>
            </div>
            <div class="section-note">从兴趣出发，用实践积累经验。</div>
          </div>

          <div class="project-grid">
            {projects.map((project) => (
              <article class="project-card">
                <div class="project-number">{project.number} / EXPLORE</div>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                <div class="tags">
                  {project.tags.map((tag) => <span class="tag">{tag}</span>)}
                </div>
              </article>
            ))}
          </div>
        </section>

        <section id="about">
          <div class="section-heading">
            <div>
              <div class="section-kicker">About Me</div>
              <h2>关于这个空间</h2>
            </div>
          </div>

          <div class="about-panel">
            <div>
              <h3>保持好奇，持续动手。</h3>
              <p>
                我正在学习计算机相关知识，也对图形学、游戏引擎和技术美术很感兴趣。
                我希望把学到的知识变成看得见、能运行、可以不断改进的作品。
                这个博客会记录学习笔记、开发过程、踩坑经验与阶段性成果。
              </p>
            </div>
            <div class="interest-list">
              {interests.map((interest) => (
                <span class="interest">{interest}</span>
              ))}
            </div>
          </div>
        </section>

        <section id="contact">
          <div class="contact">
            <div class="section-kicker">Keep In Touch</div>
            <h2>每一次尝试，都值得记录。</h2>
            <p>
              这里会持续更新学习记录与个人项目。欢迎以后回来看看。
            </p>
            <a class="button" href="#top">回到页面顶部 ↑</a>
          </div>
        </section>
      </div>
    </main>

    <footer>
      <div class="container footer-inner">
        <span>© {new Date().getFullYear()} MY.SPACE</span>
        <span>Built with Astro & ChatGPT · Designed for learning</span>
      </div>
    </footer>
  </body>
</html>
